<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx 6 (bleeding-edge / IL2CPP) packages are NOT on nuget.org.
  They are published on the official BepInEx feed below.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
