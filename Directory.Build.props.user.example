<!--
  Copy this file to  Directory.Build.props.user  (drop the ".example") and set your
  own Moon Sweepers install path. That file is git-ignored so your local path and any
  machine-specific settings never get committed.

  Alternatively, skip the file and pass the path on the command line:
     dotnet build src/MoonSweepersTwitch.csproj -c Release -p:GameDir="C:\...\Moon Sweepers"
-->
<Project>
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</GameDir>
  </PropertyGroup>
</Project>
